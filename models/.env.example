# ReClaim AI - YOLO vision service environment
# This service reads plain environment variables; it does not load a .env file
# itself. Export these in the shell that runs `python app.py`, or set them in
# whatever process manager starts it.

# ---------- Runtime ----------
# Bind address. 0.0.0.0 is the default so a container or a separate host can
# reach the service; set 127.0.0.1 when Express runs on the same machine.
HOST=0.0.0.0
PORT=5000

# The Werkzeug debugger is remote code execution for anyone who can reach the
# port. Leave this false outside a trusted local machine.
FLASK_DEBUG=false

# ---------- Access control ----------
# Shared secret with the Express server. Must match YOLO_SERVICE_TOKEN in
# server/.env. Every endpoint except /health refuses without it, and an unset
# value makes the service refuse everything with 503.
YOLO_SERVICE_TOKEN=

# Comma-separated origins allowed by CORS. This service is called by the
# Express server, not by the browser.
ALLOWED_ORIGINS=http://localhost:3001
