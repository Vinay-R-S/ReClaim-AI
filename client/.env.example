# ReClaim AI - Client environment
# Copy to `.env` and fill in.
#
# WARNING: every VITE_* value here is inlined into the production JavaScript
# bundle and is readable by anyone who loads the site. Only put values here
# that are safe to publish. No LLM keys, no service accounts, no secrets.

# ---------- API ----------
VITE_API_URL=http://localhost:3001

# ---------- Firebase web config ----------
# These are public by design; access is controlled by Firebase security rules
# and by an authorized-domain allowlist, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Maps ----------
# Geoapify browser key. Restrict it by HTTP referrer in the Geoapify console.
VITE_GEOAPIFY_API_KEY=

# ---------- Do not add ----------
# The following are currently read by the client and MUST be removed in
# Track A phase 5. They are listed here only so nobody re-adds them.
#   VITE_GROQ_API_KEY    -> defect SEC-16, key exposed in the bundle
#   VITE_GEMINI_API_KEY  -> defect SEC-16, key exposed in the bundle
#   VITE_ADMIN_EMAIL     -> defect SEC-21, replace with a role-based check
