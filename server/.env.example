# ReClaim AI - Server environment
# Copy to `.env` and fill in. Never commit the filled file.
# Every secret in this file is server-only and must NEVER be given a VITE_ prefix,
# because Vite inlines VITE_* variables into the browser bundle.

# ---------- Runtime ----------
NODE_ENV=development
PORT=3001
# debug, info, warn or error. The logger redacts identifiers and drops stack
# traces in production whatever this is set to.
LOG_LEVEL=info
# Origin of the web client, used for CORS and for links in outbound email.
CLIENT_URL=http://localhost:5173

# ---------- Firebase Admin ----------
# Base64 of the service account JSON. Falls back to application default
# credentials when unset (local dev with the gcloud CLI).
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# ---------- Handover codes ----------
# HMAC key used to hash the 6-digit handover codes. Required in production and
# must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates every handover code issued before the rotation.
HANDOVER_CODE_SECRET=

# ---------- Cloudinary (item images) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Clarifai (image similarity, optional) ----------
# When unset, image similarity scores 0. See PLAN.md defect LOG-06.
CLARIFAI_API_KEY=
CLARIFAI_PAT=
CLARIFAI_USER_ID=clarifai
CLARIFAI_APP_ID=main
CLARIFAI_MODEL_ID=general-image-recognition

# ---------- Email ----------
# Resend is the primary transport; SMTP is the fallback.
RESEND_API_KEY=
FROM_EMAIL="ReClaim AI <onboarding@resend.dev>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- AI providers ----------
# Every provider is optional and a provider with no key is simply not
# registered. At least one is needed for matching, image analysis and CCTV
# description. The admin setting chooses the order; see
# docs/architecture/ai-providers.md
GROQ_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint on this machine, such as Ollama
# (`ollama serve`, then `ollama pull llama3.2`). Free, private, and enough to
# run the pipeline end to end with no hosted keys at all. The full
# chat-completions path, not just the host:
# LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# Model identifiers move faster than deployments do. Unset means the default in
# providers/registry.ts, which is the current model for each provider.
GROQ_MODEL=
GEMINI_MODEL=
GROK_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Spend ceilings in US dollars. Zero means no ceiling, which is the behaviour
# before phase 21; a call is refused once the period is spent.
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
# Requests per provider per minute, shared across processes when Redis is set.
AI_REQUESTS_PER_MINUTE=120

# ---------- Retrieval (ADR 0003) ----------
# Hybrid retrieval: dense nearest neighbours over item vectors, fused with BM25
# over the same filtered set. It changes which candidates reach the expensive
# scorers, not how many items are read: the pipeline still loads the pending
# items of the opposite type once, because the lexical half needs a corpus.
#
#   off    - the previous retrieval, and no vector query at all
#   shadow - both run, only the previous one decides, the overlap is logged
#   on     - retrieval decides which candidates reach the scorers
#
# `shadow` is the default: read the overlap numbers in the logs before turning
# it on. Needs the vector index from firestore.indexes.json deployed, and the
# corpus embedded (`npm run backfill:embeddings`).
RETRIEVAL_MODE=shadow
RETRIEVAL_LIMIT=50

# Batched reranking (section 8.2 stage 2) is the semantic scorer: one call
# scores every candidate against every other, instead of one call per
# candidate. It has no mode. `RERANK_MODE` existed to measure it against the
# per-pair scorer, and phase 25 retired that scorer; a deployment that still
# sets the variable is warned at boot and otherwise ignored.
#
# Candidates per call. One huge prompt reasons worse and fails bigger.
RERANK_BATCH_SIZE=20

# The adjudication agent (section 8.6). A bounded tool-using agent runs on the
# single best pair, and only when its score falls inside the uncertainty band:
# above the band a pair is confirmed without asking, below it discarded.
#
#   off    - no agent runs
#   shadow - the agent runs and its verdict is recorded on the match record.
#            Nothing acts on it
#   on     - the verdict may discard a pair, confirm one, or hold one for an
#            admin instead of starting the handover automatically
#
# It can never put a pair on the automatic path that the deterministic guards
# refused, whatever it says: a verdict of `match` on a pair below the match
# threshold, or on one scored without a semantic verdict, becomes a record an
# admin decides on rather than a handover. With the default band and a
# threshold of 55 the band only demotes; lowering BAND_LOW below 55 lets the
# agent surface a sub-threshold pair for review.
ADJUDICATION_MODE=shadow
ADJUDICATION_BAND_LOW=60
ADJUDICATION_BAND_HIGH=85
# Bounds on one run. The deadline covers every model and tool call in it.
ADJUDICATION_MAX_TOOL_CALLS=8
ADJUDICATION_DEADLINE_MS=20000
# How sure the agent must be before its verdict is allowed to move a pair.
ADJUDICATION_MIN_CONFIDENCE=70

# ---------- Embeddings (ADR 0004) ----------
# Text and image vectors are computed in this process on CPU, with ONNX
# Runtime. No key, no vendor, no per-item cost, and no item text leaves the
# deployment. Model files download once into MODEL_CACHE_DIR; run
# `npm run warm-models` to fetch them ahead of the first request, which is what
# a container image should do at build time.
#
# Set EMBEDDINGS_ENABLED=false to turn the feature off entirely.
EMBEDDINGS_ENABLED=true
MODEL_CACHE_DIR=./.models

# Both models are pinned by revision. `main` follows the repository, which is
# fine locally and wrong in production: pin a commit, because a model that
# changes under a corpus of stored vectors makes them incomparable.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DIMENSIONS=384
# Xenova/all-MiniLM-L6-v2 is the faster alternative at the same 384 dimensions,
# so it swaps in with a backfill and no schema change.

EMBEDDING_IMAGE_MODEL=Xenova/clip-vit-base-patch32
EMBEDDING_IMAGE_MODEL_REVISION=main
EMBEDDING_IMAGE_DIMENSIONS=512

# Pin threads to the CPU the container actually has. The default of 1 is the
# safe one: ONNX Runtime otherwise takes a thread per core the host reports,
# which in a fractional-CPU container makes inference slower, not faster.
EMBEDDING_THREADS=1
EMBEDDING_BATCH_SIZE=16
# True refuses the network, so a deployment with a warm cache fails loudly
# rather than reaching out on first use.
EMBEDDINGS_OFFLINE=false

# ---------- Queue and worker ----------
# Background jobs (matching today, embeddings and notifications later) run in a
# separate worker process fed by Redis. `docker compose up -d redis` from the
# repository root gives you the local one.
#
# Unset is supported and is not the same as broken: without it the API runs
# jobs in its own process and drains its own outbox, which is what the system
# did before the queue existed. Nothing survives a restart in that mode, and
# `npm run worker` refuses to start at all. See docs/adr/0005-redis-job-queue.md
REDIS_URL=redis://localhost:6379
# How many jobs one worker process runs at once.
QUEUE_CONCURRENCY=4
# How often the outbox is polled, and how many events a pass takes.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20

# ---------- CCTV vision service ----------
YOLO_SERVICE_URL=http://localhost:5000
# Shared secret sent to the Flask service on every proxied call. Must match
# YOLO_SERVICE_TOKEN in the models environment; without it that service refuses
# every request. Generate one with: openssl rand -hex 32
YOLO_SERVICE_TOKEN=

# ---------- Blockchain (optional) ----------
# Leave BLOCKCHAIN_ENABLED=false unless a contract is deployed.
# ADMIN_PRIVATE_KEY signs live transactions. Use a dedicated low-value wallet.
# See PLAN.md defect SEC-25.
BLOCKCHAIN_ENABLED=false
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
ADMIN_PRIVATE_KEY=
