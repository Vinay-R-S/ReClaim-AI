# ReClaim AI - Server environment
# Copy to `.env` and fill in. Never commit the filled file.
# Every secret in this file is server-only and must NEVER be given a VITE_ prefix,
# because Vite inlines VITE_* variables into the browser bundle.

# ---------- Runtime ----------
NODE_ENV=development
PORT=3001
# debug, info, warn or error. The logger redacts identifiers and drops stack
# traces in production whatever this is set to.
LOG_LEVEL=info
# Origin of the web client, used for CORS and for links in outbound email.
CLIENT_URL=http://localhost:5173

# ---------- Firebase Admin ----------
# Base64 of the service account JSON. Falls back to application default
# credentials when unset (local dev with the gcloud CLI).
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# ---------- Handover codes ----------
# HMAC key used to hash the 6-digit handover codes. Required in production and
# must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates every handover code issued before the rotation.
HANDOVER_CODE_SECRET=

# ---------- Cloudinary (item images) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Clarifai (image similarity, optional) ----------
# When unset, image similarity scores 0. See PLAN.md defect LOG-06.
CLARIFAI_API_KEY=
CLARIFAI_PAT=
CLARIFAI_USER_ID=clarifai
CLARIFAI_APP_ID=main
CLARIFAI_MODEL_ID=general-image-recognition

# ---------- Email ----------
# Resend is the primary transport; SMTP is the fallback.
RESEND_API_KEY=
FROM_EMAIL="ReClaim AI <onboarding@resend.dev>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- AI providers ----------
# Every provider is optional and a provider with no key is simply not
# registered. At least one is needed for matching, image analysis and CCTV
# description. The admin setting chooses the order; see
# docs/architecture/ai-providers.md
GROQ_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint on this machine, such as Ollama
# (`ollama serve`, then `ollama pull llama3.2`). Free, private, and enough to
# run the pipeline end to end with no hosted keys at all. The full
# chat-completions path, not just the host:
# LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# Model identifiers move faster than deployments do. Unset means the default in
# providers/registry.ts, which is the current model for each provider.
GROQ_MODEL=
GEMINI_MODEL=
GROK_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Spend ceilings in US dollars. Zero means no ceiling, which is the behaviour
# before phase 21; a call is refused once the period is spent.
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
# Requests per provider per minute, shared across processes when Redis is set.
AI_REQUESTS_PER_MINUTE=120

# ---------- Queue and worker ----------
# Background jobs (matching today, embeddings and notifications later) run in a
# separate worker process fed by Redis. `docker compose up -d redis` from the
# repository root gives you the local one.
#
# Unset is supported and is not the same as broken: without it the API runs
# jobs in its own process and drains its own outbox, which is what the system
# did before the queue existed. Nothing survives a restart in that mode, and
# `npm run worker` refuses to start at all. See docs/adr/0005-redis-job-queue.md
REDIS_URL=redis://localhost:6379
# How many jobs one worker process runs at once.
QUEUE_CONCURRENCY=4
# How often the outbox is polled, and how many events a pass takes.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20

# ---------- CCTV vision service ----------
YOLO_SERVICE_URL=http://localhost:5000
# Shared secret sent to the Flask service on every proxied call. Must match
# YOLO_SERVICE_TOKEN in the models environment; without it that service refuses
# every request. Generate one with: openssl rand -hex 32
YOLO_SERVICE_TOKEN=

# ---------- Blockchain (optional) ----------
# Leave BLOCKCHAIN_ENABLED=false unless a contract is deployed.
# ADMIN_PRIVATE_KEY signs live transactions. Use a dedicated low-value wallet.
# See PLAN.md defect SEC-25.
BLOCKCHAIN_ENABLED=false
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
ADMIN_PRIVATE_KEY=
