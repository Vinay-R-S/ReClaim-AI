# ReClaim AI - Client environment
#
# It lives at the repository root because that is where Vite reads it from
# (`envDir: '..'` in `client/vite.config.ts`); a `client/.env` is never loaded.
# Copy to `.env` and fill in. The server has its own, in `server/.env.example`.
#
# WARNING: every VITE_* value here is inlined into the production JavaScript
# bundle and is readable by anyone who loads the site. Only put values here
# that are safe to publish. No LLM keys, no service accounts, no secrets.

# ---------- API ----------
VITE_API_URL=http://localhost:3001

# ---------- Firebase web config ----------
# These are public by design; access is controlled by Firebase security rules
# and by an authorized-domain allowlist, not by hiding these values.
# All of these are required. There are no hardcoded fallbacks any more, so a
# build with an empty value fails fast instead of silently pointing at the
# production project (defect SEC-21). VITE_FIREBASE_MEASUREMENT_ID is optional:
# without it, Analytics is not initialised.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------- Maps ----------
# Geoapify browser key. Restrict it by HTTP referrer in the Geoapify console.
VITE_GEOAPIFY_API_KEY=

# ---------- Removed ----------
# VITE_GROQ_API_KEY, VITE_GEMINI_API_KEY and VITE_ADMIN_EMAIL are gone.
# The two LLM keys were inlined into the bundle and readable by anyone who
# loaded the site (defect SEC-16); model calls now go through the server at
# /api/ai/*, and the provider is chosen by the admin `aiProvider` setting.
# VITE_ADMIN_EMAIL was a build-time filter for the admin users list and is
# replaced by a role check (defect SEC-21).
#
# If either LLM key was ever set here, rotate it: it is in every bundle ever
# shipped.
