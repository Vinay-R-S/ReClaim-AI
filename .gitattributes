# Normalize line endings so a file's content, not the checkout platform,
# determines its diff. Without this, a file with identical content shows as
# fully rewritten when compared across machines.
* text=auto eol=lf

# Explicitly text
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.py      text eol=lf
*.sol     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.txt     text eol=lf
.env.example text eol=lf

# Explicitly binary, never diffed or line-ending converted
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.pdf     binary
*.pt      binary
*.ico     binary
*.woff    binary
*.woff2   binary

# Generated. Collapse in diffs and reviews.
package-lock.json linguist-generated=true -diff
